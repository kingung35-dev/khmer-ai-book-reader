#!/bin/bash
# ==============================================================================
# Khmer AI Book Reader - 1-Click Update Script for Mac & Cloud
# រត់ស្វ័យប្រវត្តិនូវការរក្សាទុក និង Push ទៅកាន់ GitHub & Render.com
# ==============================================================================

cd "$(dirname "$0")"

echo "=========================================================="
echo "  📖 Khmer AI Book Reader — កម្មវិធី Update ស្វ័យប្រវត្តិ"
echo "=========================================================="
echo ""

# បង្ហាញឯកសារដែលបានកែប្រែ
echo "🔍 កំពុងពិនិត្យឯកសារដែលបានកែប្រែ..."
git status -s

echo ""
read -p "📝 សូមបញ្ចូលចំណាំ Update (ឬចុច Enter យកទូទៅ): " msg
if [ -z "$msg" ]; then
  msg="Update: $(date '+%Y-%m-%d %H:%M:%S')"
fi

echo ""
echo "🚀 កំពុង Upload កំណែថ្មីទៅកាន់ GitHub & Render.com..."
git add .
git commit -m "$msg" || echo "គ្មានការកែប្រែថ្មីទេ"
git push origin main

echo ""
echo "=========================================================="
echo "  ✅ UPDATE ជោគជ័យ ១០០%!"
echo "=========================================================="
echo "  1. Render.com នឹង Auto-Deploy កំណែថ្មីក្នុងរយៈពេល ១-២ នាទី"
echo "  2. លើទូរស័ព្ទដៃ៖ គ្រាន់តែបិទបើក App ឡើងវិញដើម្បីទទួលបានមុខងារថ្មី"
echo "  3. លើ Mac៖ បើកដំណើរការតាម start.command ដូចធម្មតា"
echo "=========================================================="
echo ""
read -p "ចុច Enter ដើម្បីចាកចេញ..."
